<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.liberdadefinanceira.corrida"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="36" />

    <queries>
        <package android:name="com.itsaky.androidide" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.itsaky.androidide.permission.BIND_LOG_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="Corrida pela Liberdade Financeira"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false" >
        <activity
            android:name="br.com.liberdadefinanceira.corrida.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.itsaky.androidide.logsender.utils.LogSenderInstaller"
            android:authorities="br.com.liberdadefinanceira.corrida.logsender-installer"
            android:enabled="@bool/logsender_enabled"
            android:exported="false" />

        <service
            android:name="com.itsaky.androidide.logsender.LogSenderService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>